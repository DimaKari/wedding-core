# Wedding Core — Supabase project connection.

# Tenant-scoped connection — what a frontend actually uses at runtime.
# Authenticates as the low-privilege `wedding_app` role created in
# migrations/0001_init.sql — not a table owner, not service_role.
WEDDING_DATABASE_URL="postgresql://wedding_app:<password>@<project-ref>.supabase.co:5432/postgres"

# Privileged connection — running migrations.sql ONLY. Never used at runtime.
ADMIN_DATABASE_URL="postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres"

# Which brand this deployment is permanently bound to — set per frontend,
# never derived per-request. "dimax" | "dkhochzeitart".
WEDDING_CORE_BRAND="dimax"
