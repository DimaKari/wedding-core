# Wedding Core — Supabase project connection.
#
# Two DISTINCT connection strings, matching architecture doc section L.9.2
# ("Zwei-Wege-Strategie"). Never use the privileged one in a frontend.

# Tenant-scoped connection — the ONLY one a frontend (dimaxwedding_projekt,
# DKHochzeitArt/Website) ever uses. Authenticates as the low-privilege
# `wedding_core_app` role created in packages/db/migrations/0001_init.sql —
# not a table owner, not service_role, no BYPASSRLS.
DATABASE_URL="postgresql://wedding_core_app:<password>@<project-ref>.supabase.co:5432/postgres"

# Privileged connection — migrations and the (future, not yet built) internal
# admin tool ONLY. Never imported by frontend request-handling code. Kept in
# a separate env var on purpose, so it's grep-able and can't be reached for
# by accident where DATABASE_URL was meant.
ADMIN_DATABASE_URL="postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres"

# Dev-only brand override for local frontend development (see
# packages/contract-core/src/brand-guard.ts). Never read when NODE_ENV=production.
WEDDING_CORE_DEV_BRAND="dimax"
